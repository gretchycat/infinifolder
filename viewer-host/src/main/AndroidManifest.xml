<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application android:label="${viewerName}" android:theme="@style/AppTheme">
        <activity android:name="com.infinifolder.standalone.ViewerHostActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="${viewerMime1}" />
                <data android:mimeType="${viewerMime2}" />
                <data android:mimeType="${viewerMime3}" />
                <data android:mimeType="${viewerMime4}" />
                <data android:mimeType="${viewerMime5}" />
                <data android:mimeType="${viewerMime6}" />
                <data android:mimeType="${viewerMime7}" />
                <data android:mimeType="${viewerMime8}" />
            </intent-filter>
        </activity>
    </application>
</manifest>
