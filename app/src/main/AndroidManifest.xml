<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission android:name="com.infinifolder.permission.READ_SELECTION"
        android:protectionLevel="signature" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <queries>
        <intent>
            <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
        </intent>
    </queries>
    <application
        android:name=".InfiniFolderApplication"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme"
        android:label="InfiniFolder"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:supportsRtl="true">

        <provider android:name=".StorageDocumentsProvider"
            android:authorities="com.infinifolder.documents"
            android:exported="true" android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter><action android:name="android.content.action.DOCUMENTS_PROVIDER" /></intent-filter>
        </provider>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|uiMode">
            <!-- Open-with filters are generated from the supported-type registry. -->
        </activity>







        <activity
            android:name=".HomeItemActivity"
            android:exported="true"
            android:theme="@style/HomeShortcutTheme"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".HomeShortcutDragActivity"
            android:exported="false"
            android:theme="@style/HomeShortcutTheme"
            android:excludeFromRecents="true"
            android:taskAffinity="" />
        <activity
            android:name=".FileSelectionActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="io.github.gretchycat.infiniselect.action.SELECT_FILE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="io.github.gretchycat.infiniselect.action.SAVE_FILE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <provider
            android:name=".FileSelectionRelayProvider"
            android:authorities="${applicationId}.selection"
            android:exported="true"
            android:grantUriPermissions="true">
            <!-- The authority root is the public resolver API. File paths require
                 URI grants, so Android records rather than elides those grants. -->
            <path-permission android:pathPrefix="/"
                android:readPermission="com.infinifolder.permission.READ_SELECTION"
                android:writePermission="com.infinifolder.permission.READ_SELECTION" />
        </provider>
        <activity android:name=".TermuxEditActivity" android:exported="false" />
        <activity-alias android:name=".TermuxFileHandler" android:targetActivity=".TermuxEditActivity"
            android:exported="true" android:enabled="false" android:label="Open with Termux">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/x-python" />
                <data android:mimeType="application/x-python" />
                <data android:mimeType="application/x-python-code" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>
        </activity-alias>
        <activity android:name=".TermuxEditResultActivity" android:exported="false" />
        <receiver android:name=".TermuxPackageReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_FULLY_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>
        <receiver android:name=".TermuxProbeReceiver" android:exported="false" />
        <receiver android:name=".ShortcutUpdateReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".ops.OperationService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".overlay.FloatingContainerService"
            android:exported="false" />
        <meta-data android:name="com.infinifolder.CACHE_COPY_HANDLER" android:value="com.infinifolder.MainActivity" />
    </application>
</manifest>
