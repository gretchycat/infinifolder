<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug-only report remains explicitly launchable for diagnosis but does not
             install a second launcher icon or become the default app entry point. -->
        <activity
            android:name=".StartupReportActivity"
            android:process=":startup_report"
            android:enabled="@bool/startup_report_supported"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:label="InfiniFolder startup report" />
    </application>
</manifest>
