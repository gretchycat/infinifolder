+/* Fixture-host UTF-16 conversion. No truncating high bytes of catalog names. */
+char* unicodeToAscii(HFSUniStr255* str) {
+    if (str->length > 255) hfs_panic("Oversized Unicode fixture name");
+    unsigned char bytes[510];
+    for (size_t i = 0; i < str->length; ++i) {
+        bytes[i * 2] = str->unicode[i] & 255;
+        bytes[i * 2 + 1] = str->unicode[i] >> 8;
+    }
+    size_t inleft = str->length * 2, capacity = str->length * 3 + 1;
+    char *result = malloc(capacity), *input = (char *)bytes, *output = result;
+    if (!result) hfs_panic("Cannot allocate Unicode fixture name");
+    size_t outleft = capacity - 1;
+    iconv_t converter = iconv_open("UTF-8", "UTF-16LE");
+    if (converter == (iconv_t)-1) hfs_panic("Cannot open UTF-16 converter");
+    size_t status = iconv(converter, &input, &inleft, &output, &outleft);
+    iconv_close(converter);
+    if (status == (size_t)-1 || inleft) hfs_panic("Invalid UTF-16 fixture name");
+    *output = 0;
+    return result;
 }
 
