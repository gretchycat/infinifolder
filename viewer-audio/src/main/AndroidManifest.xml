<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <meta-data android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.infinifolder.audio.cast.StandardCastOptions" />
        <receiver android:name="androidx.mediarouter.media.MediaTransferReceiver" android:exported="true" />
        <activity android:name="com.infinifolder.audio.cast.CastRouteActivity"
            android:exported="false" android:theme="@style/CastRouteTheme" />
        <activity
            android:name="com.infinifolder.viewer.AudioPlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|uiMode"
            android:launchMode="singleTop"
            android:theme="@style/AppTheme" />
        <service
            android:name="com.infinifolder.viewer.AudioPlayerService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
